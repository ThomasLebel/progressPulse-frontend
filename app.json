{
  "expo": {
    "name": "ProgressPulse",
    "slug": "progresspule",
    "description": "Une application de suivi d'entraînement pour les sportifs.",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/illustrations/LogoV2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/illustrations/LogoV2.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/illustrations/LogoV2.png"
    },
    "extra": {
      "eas": {
        "projectId": "073b9ab9-b0d3-452b-8356-4ca49a271182"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/073b9ab9-b0d3-452b-8356-4ca49a271182"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8BC34A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-audio",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/illustrations/LogoV2.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D36",
          "imageWidth": 200
        }
      ]
    ]
  }
}
