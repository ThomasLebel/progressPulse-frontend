{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Permissive — migration progressive JS → TS
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,

    // Autoriser les fichiers JS sans les vérifier
    "allowJs": true,
    "checkJs": false,

    // Divers
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx"
  ]
}
