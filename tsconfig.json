{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Strict checks activés
    "strict": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictNullChecks": true,

    // Autoriser les fichiers JS sans les vérifier
    "allowJs": true,
    "checkJs": false,

    // Divers
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx"
  ]
}
